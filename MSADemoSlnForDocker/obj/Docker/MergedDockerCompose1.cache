        com.microsoft.visual-studio.project-name: OrderAPI
      target: base
    depends_on:
      catalogapi:
        condition: service_started
        required: true
    entrypoint:
      - dotnet
      - --roll-forward
      - Major
      - /VSTools/DistrolessHelper/DistrolessHelper.dll
