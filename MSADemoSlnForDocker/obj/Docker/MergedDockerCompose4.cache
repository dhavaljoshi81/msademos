name: dockercompose13427163604775129062
services:
  catalogapi:
    build:
      context: C:\Git Repos\Docker\MSADamos\MSADemoSlnForDocker
      dockerfile: CatalogAPI/Dockerfile
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "8080"
    image: catalogapi
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8080
        published: "5139"
        protocol: tcp
  catalogwebui:
    build:
      context: C:\Git Repos\Docker\MSADamos\MSADemoSlnForDocker
      dockerfile: CatalogWebUI/Dockerfile
    depends_on:
      catalogapi:
        condition: service_started
        required: true
    image: catalogwebui
    networks:
      default: null
    ports:
      - mode: ingress
        target: 80
        published: "5050"
        protocol: tcp
  orderapi:
    build:
      context: C:\Git Repos\Docker\MSADamos\MSADemoSlnForDocker
      dockerfile: OrderAPI/Dockerfile
    depends_on:
      catalogapi:
        condition: service_started
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "8080"
      Services__CatalogUrl: http://catalogapi:8080
    image: orderapi
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8080
        published: "5140"
        protocol: tcp
networks:
  default:
    name: dockercompose13427163604775129062_default