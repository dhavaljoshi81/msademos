@page "/catalog"
@inject CatalogHttpService CatalogService

<PageTitle>Catalog Management</PageTitle>

<div class="container mt-4">
    <h2 class="mb-4">📦 Product Catalog Management</h2>

    <!-- CREATE / EDIT FORM -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">@(isEditing ? "Edit Catalog Item" : "Add New Item")</h5>
        </div>
        <div class="card-body">
            <EditForm Model="@currentItem" OnValidSubmit="SaveItem">
                <DataAnnotationsValidator />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Name</label>
                        <InputText @bind-Value="currentItem.Name" class="form-control" placeholder="Item Name" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Price ($)</label>
                        <InputNumber @bind-Value="currentItem.Price" class="form-control" step="0.01" min="0" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Available Stock</label>
                        <InputNumber @bind-Value="currentItem.AvailableStock" class="form-control" min="0" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <InputTextArea @bind-Value="currentItem.Description" class="form-control" rows="2" placeholder="Item Description" />
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-success me-2">
                        @(isEditing ? "Update Product" : "Create Product")
                    </button>
                    @if (isEditing)
                    {
                        <button type="button" class="btn btn-secondary" @onclick="ResetForm">Cancel</button>
                    }
                </div>
            </EditForm>
        </div>
    </div>

    <!-- ERROR / STATUS MESSAGES -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
        </div>
    }

    <!-- CATALOG TABLE -->
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Current Catalog Items</h5>
        </div>
        <div class="card-body p-0">
            @if (items == null)
            {
                <div class="p-4 text-center">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2">Loading products from CatalogAPI...</p>
                </div>
            }
            else if (!items.Any())
            {
                <div class="p-4 text-center text-muted">No items found in database.</div>
            }
            else
            {
                <table class="table table-striped table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td><strong>@item.Name</strong></td>
                                <td>@item.Description</td>
                                <td>$@item.Price.ToString("F2")</td>
                                <td>
                                    <span class="badge @(item.AvailableStock > 10 ? "bg-success" : "bg-warning")">
                                        @item.AvailableStock
                                    </span>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => EditItem(item)">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteItem(item.Id)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@code {
    private List<CatalogItem>? items;
    private CatalogItem currentItem = new();
    private bool isEditing = false;
    private string? statusMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadItems();
    }

    private async Task LoadItems()
    {
        try
        {
            items = await CatalogService.GetItemsAsync();
        }
        catch (Exception ex)
        {
            statusMessage = $"Failed to connect to CatalogAPI: {ex.Message}";
        }
    }

    private async Task SaveItem()
    {
        bool success;
        if (isEditing)
        {
            success = await CatalogService.UpdateItemAsync(currentItem);
            statusMessage = success ? "Item updated successfully!" : "Failed to update item.";
        }
        else
        {
            success = await CatalogService.CreateItemAsync(currentItem);
            statusMessage = success ? "Item created successfully!" : "Failed to create item.";
        }

        if (success)
        {
            ResetForm();
            await LoadItems();
        }
    }

    private void EditItem(CatalogItem item)
    {
        currentItem = new CatalogItem
        {
            Id = item.Id,
            Name = item.Name,
            Description = item.Description,
            Price = item.Price,
            AvailableStock = item.AvailableStock
        };
        isEditing = true;
    }

    private async Task DeleteItem(int id)
    {
        var success = await CatalogService.DeleteItemAsync(id);
        statusMessage = success ? "Item deleted successfully!" : "Failed to delete item.";
        if (success)
        {
            await LoadItems();
        }
    }

    private void ResetForm()
    {
        currentItem = new CatalogItem();
        isEditing = false;
    }
}